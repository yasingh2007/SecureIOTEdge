# Copy to prj.conf and tune for your board.

CONFIG_MAIN_STACK_SIZE=4096
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=4096
CONFIG_HEAP_MEM_POOL_SIZE=81920

# Logging
CONFIG_LOG=y
CONFIG_LOG_MODE_DEFERRED=y

# Persistent Wi-Fi credentials (BLE provisioning)
CONFIG_FLASH=y
CONFIG_FLASH_MAP=y
CONFIG_SETTINGS=y
CONFIG_SETTINGS_NVS=y
CONFIG_NVS=y

# Bluetooth provisioning GATT
CONFIG_BT=y
CONFIG_BT_PERIPHERAL=y
CONFIG_BT_DEVICE_NAME="SecureIoTEdge"
CONFIG_BT_GATT_DYNAMIC_DB=y
CONFIG_SECURE_IOT_EDGE_BLE_PROVISION=y
CONFIG_SECURE_IOT_EDGE_BLE_PROVISION_WINDOW_SEC=300
CONFIG_SECURE_IOT_EDGE_BLE_PROVISION_STOP_ON_NETWORK=y
# CONFIG_SECURE_IOT_EDGE_BLE_PROVISION_ALWAYS=y

# Wi-Fi (lab fallback — prefer BLE + NVS in field)
CONFIG_WIFI=y
CONFIG_NET_IPV4=y
CONFIG_NET_DHCPV4=y
CONFIG_NET_CONNECTION_MANAGER=y
CONFIG_SECURE_IOT_EDGE_WIFI=y
CONFIG_SECURE_IOT_EDGE_WIFI_RECONNECT_MIN_SEC=3
CONFIG_SECURE_IOT_EDGE_WIFI_RECONNECT_MAX_SEC=120
# CONFIG_SECURE_IOT_EDGE_WIFI_SSID="lab-ssid"
# CONFIG_SECURE_IOT_EDGE_WIFI_PSK="lab-password"

# MQTT (IPv4 or hostname + optional TLS)
CONFIG_NETWORKING=y
CONFIG_NET_SOCKETS=y
CONFIG_DNS_RESOLVER=y
CONFIG_JSON_LIBRARY=y
CONFIG_MQTT_LIB=y
CONFIG_MQTT_LIB_TLS=y
CONFIG_MBEDTLS=y
CONFIG_MBEDTLS_PEM_CERTIFICATE_FORMAT=y
CONFIG_TLS_CREDENTIALS=y
CONFIG_SECURE_IOT_EDGE_MQTT=y
CONFIG_SECURE_IOT_EDGE_MQTT_HOST="mqtt.local"
CONFIG_SECURE_IOT_EDGE_MQTT_PORT=8883
CONFIG_SECURE_IOT_EDGE_MQTT_TLS=y
# CONFIG_SECURE_IOT_EDGE_MQTT_TLS_INSECURE=y
CONFIG_SECURE_IOT_EDGE_MQTT_TOPIC_TELEMETRY="iot/edge/telemetry"
CONFIG_SECURE_IOT_EDGE_MQTT_TOPIC_CMD="iot/edge/cmd"
CONFIG_SECURE_IOT_EDGE_APP_VERSION="1.0.0"

# Plain MQTT lab profile (no TLS):
# CONFIG_SECURE_IOT_EDGE_MQTT_HOST="192.168.1.10"
# CONFIG_SECURE_IOT_EDGE_MQTT_PORT=1883
# CONFIG_SECURE_IOT_EDGE_MQTT_TLS=n

# MCUboot / FOTA
CONFIG_BOOTLOADER_MCUBOOT=y
CONFIG_IMG_MANAGER=y
CONFIG_MCUBOOT_IMG_MANAGER=y
CONFIG_STREAM_FLASH=y
CONFIG_SECURE_IOT_EDGE_FOTA=y

# Sensors
CONFIG_SENSOR=y
CONFIG_SECURE_IOT_EDGE_SENSORS=y
# CONFIG_BME680=y

# Power
CONFIG_PM=y
CONFIG_PM_DEVICE=y
CONFIG_SECURE_IOT_EDGE_POWER_MGMT=y

# Optional SMP OTA over BLE (enable when demoing MCUmgr)
# CONFIG_MCUMGR=y
# CONFIG_MCUMGR_TRANSPORT_BT=y

# Optional shell
# CONFIG_SHELL=y
# CONFIG_SECURE_IOT_EDGE_DIAG_SHELL=y
